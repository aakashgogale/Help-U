{
  "name": "help-u-backend",
  "version": "1.0.0",
  "description": "Backend API for Help-U platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/runAllCatalogTests.js",
    "test:catalog": "node tests/runAllCatalogTests.js",
    "test:validators": "node tests/validators.test.js",
    "test:nesting": "node tests/nestingRules.test.js",
    "test:dependencies": "node tests/dependencyCheck.test.js",
    "test:migration": "node tests/migrationIdempotency.test.js",
    "test:public-catalog": "node tests/publicCatalog.test.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:database": "node scripts/seedDatabase.js",
    "seed:electrician": "node scripts/seedElectricianService.js",
    "seed:category-sections": "node scripts/seedHomeCategorySections.js",
    "seed:workers": "node scripts/seedWorkers.js",
    "seed:worker-bookings": "node scripts/seedWorkerBookings.js",
    "seed:worker-data": "npm run seed:workers && npm run seed:worker-bookings",
    "upload:category-icons": "node scripts/uploadCategoryImages.js",
    "upload:home-content-images": "node scripts/uploadHomeContentImages.js",
    "update:home-content-images": "node scripts/updateHomeContentImages.js",
    "migrate:category-icons": "node scripts/migrateCategoryIcons.js",
