    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.6.0",
