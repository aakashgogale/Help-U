# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration*
MONGODB_URI=


# JWT Configuration
JWT_SECRET=your-sut-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refreshcret-change-this-in-production
JWT_REFRESH_EXPIRE=30d


# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173


# Realtime & Queue Configuration
# Redis Configuration - Set REDIS_ENABLED=true to use Redis caching
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
TOKEN_QUEUE_DEFAULT_AVG_MINUTES=15
TOKEN_QUEUE_MAX_RECALLS=2
QUEUE_RECALC_CRON=*/5 * * * *
QUEUE_NOSHOW_CRON=*/10 * * * *

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=h
CLOUDINARY_API_KEY=638952
